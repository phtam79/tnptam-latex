\def\TFTrue{\space} % Dấu hiệu đúng
% Lệnh hiển thị từng lựa chọn
\newcommand{\dstest}[1]{%
  \stepcounter{pads}\par\noindent\thepads)%
  \def\flag{}% Xác định cờ tạm thời
  \IfSubStr{\detokenize{#1}}{\detokenize{\TFTrue}}{\def\flag{\True}}{\def\flag{\False}}%
  \ifshowproblems \IfSubStr{\detokenize{#1}}{\detokenize{\TFTrue}}{#1}{\space #1}\fi % Hiển thị nội dung câu hỏi
  \ifshowanswers \space\flag\fi \par% Hiển thị Đ/S
}


\newcommand\setpa{\setcounter{pads}{0}}%
\newcommand\bonpads[5][0]{%
\setcounter{pads}{0}%
\count1=\value{enumi}%
\pgfmathsetmacro{\daopamot}{int(mod(\the\numexpr\matonghop+\count1, 2))}%
\pgfmathsetmacro{\daopahai}{int(mod(\the\numexpr\matonghop+\count1, 6))}%
\pgfmathsetmacro{\daopaba}{int(mod(\the\numexpr\matonghop+\count1, 24))}%
 %%%%%%%%%%%%%%%%%%
\ifcase#1%
    % Trường hợp mặc định (0): Thứ tự gốc
    \dstest{#2}\dstest{#3}\dstest{#4}\dstest{#5}%
  \or
    % Trường hợp 1: Hoán đổi #3 và #4, giữ nguyên #2 và #5
    \ifodd\daopamot
    \dstest{#2}\dstest{#3}\dstest{#4}\dstest{#5}%
    \else
    \dstest{#2}\dstest{#4}\dstest{#3}\dstest{#5}%
   \fi
  \or
    % Trường hợp 2: Hoán đổi #3, #4, và #5, giữ nguyên #2
   \ifcase\daopahai%
    \dstest{#2}\dstest{#3}\dstest{#4}\dstest{#5}%
  \or
    \dstest{#2}\dstest{#3}\dstest{#5}\dstest{#4}%
  \or
    \dstest{#2}\dstest{#4}\dstest{#3}\dstest{#5}%
  \or
    \dstest{#2}\dstest{#4}\dstest{#5}\dstest{#3}%
  \or
    \dstest{#2}\dstest{#5}\dstest{#3}\dstest{#4}%
  \or
    \dstest{#2}\dstest{#5}\dstest{#4}\dstest{#3}%
   \fi
  \else
    % Trường hợp >= 3: Hoán đổi toàn bộ #2, #3, #4, #5
  \ifcase\daopaba%
    \dstest{#2}\dstest{#3}\dstest{#4}\dstest{#5}%
  \or
    \dstest{#2}\dstest{#3}\dstest{#5}\dstest{#4}%
  \or
    \dstest{#2}\dstest{#4}\dstest{#3}\dstest{#5}%
  \or
    \dstest{#2}\dstest{#4}\dstest{#5}\dstest{#3}%
  \or
    \dstest{#2}\dstest{#5}\dstest{#3}\dstest{#4}%
  \or
    \dstest{#2}\dstest{#5}\dstest{#4}\dstest{#3}%
  \or
    \dstest{#3}\dstest{#2}\dstest{#4}\dstest{#5}%
  \or
    \dstest{#3}\dstest{#2}\dstest{#5}\dstest{#4}%
  \or
    \dstest{#3}\dstest{#4}\dstest{#2}\dstest{#5}%
  \or
    \dstest{#3}\dstest{#4}\dstest{#5}\dstest{#2}%
  \or
    \dstest{#3}\dstest{#5}\dstest{#2}\dstest{#4}%
  \or
    \dstest{#3}\dstest{#5}\dstest{#4}\dstest{#2}%
  \or
    \dstest{#4}\dstest{#2}\dstest{#3}\dstest{#5}%
  \or
    \dstest{#4}\dstest{#2}\dstest{#5}\dstest{#3}%
  \or
    \dstest{#4}\dstest{#3}\dstest{#2}\dstest{#5}%
  \or
    \dstest{#4}\dstest{#3}\dstest{#5}\dstest{#2}%
  \or
    \dstest{#4}\dstest{#5}\dstest{#2}\dstest{#3}%
  \or
    \dstest{#4}\dstest{#5}\dstest{#3}\dstest{#2}%
  \or
    \dstest{#5}\dstest{#2}\dstest{#3}\dstest{#4}%
  \or
    \dstest{#5}\dstest{#2}\dstest{#4}\dstest{#3}%
  \or
